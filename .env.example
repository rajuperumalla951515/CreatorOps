# ==============================================================================
# TubePilot AI — Environment & Security Configuration Template (.env.example)
# Copy this file to '.env' and fill in your values. NEVER commit '.env' to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION (PostgreSQL + RLS + Client SDK)
# ------------------------------------------------------------------------------
# Frontend Client Configuration (safe for browser exposure with RLS)
VITE_SUPABASE_URL=https://xepcqtvzehjnijdvjcfe.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_e77cpinfc4g9cV8s2vTQBw_BXDdlq38

# Backend Supabase Integration (Server-side JWT validation)
SUPABASE_URL=https://xepcqtvzehjnijdvjcfe.supabase.co
SUPABASE_ANON_KEY=sb_publishable_e77cpinfc4g9cV8s2vTQBw_BXDdlq38
# Optional: Service Role key for backend maintenance (NEVER expose in frontend)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ------------------------------------------------------------------------------
# 2. PRIVATE ACCESS KEY & BACKEND SECURITY
# ------------------------------------------------------------------------------
# Master access key for single-creator lock or developer access:
CREATOR_ACCESS_KEY=your_secure_password_or_pin_here

# ------------------------------------------------------------------------------
# 3. GOOGLE CLOUD & OFFICIAL YOUTUBE DATA API V3
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console (APIs & Services > Credentials):
# Required APIs: "YouTube Data API v3"
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret

# OAuth Redirect URI:
# Local development: http://localhost:5173
# Production deployment: https://your-tubepilot-domain.vercel.app or https://your-backend.onrender.com/api/youtube/callback
YOUTUBE_REDIRECT_URI=http://localhost:5173

# ------------------------------------------------------------------------------
# 4. SERVER & NETWORK DEPLOYMENT
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# Centralized API Base URL for React frontend
# Local dev: http://localhost:8000
# Production Render backend: https://your-service.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Allowed CORS origins for FastAPI (comma-separated, or '*' in local dev)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
