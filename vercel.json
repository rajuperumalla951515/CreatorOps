{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend-react": {
      "root": "CreatorAgent/frontend-react"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://tubepilot-ai.onrender.com/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://tubepilot-ai.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend-react"
      }
    }
  ]
}
